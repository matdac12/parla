{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parla",
  "version": "0.1.2",
  "identifier": "com.matdac6.parla",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/matdac12/parla/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mattia Da Campo",
    "copyright": "Copyright (c) 2026 Mattia Da Campo",
    "homepage": "https://github.com/matdac12/parla",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Fast push-to-talk dictation for Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
